{
  "name": "@mtg/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript Magic: The Gathering rules engine",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@mtg/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
